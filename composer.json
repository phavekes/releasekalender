{
    "name": "phavekes/releasecalendar",
    "description": "Release Calendar - PHP application for managing software releases",
    "type": "project",
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-session": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^2.2",
        "squizlabs/php_codesniffer": "^3.7",
        "phpcompatibility/php-compatibility": "^9.3"
    },
    "autoload": {
        "files": [
            "src/Config.php",
            "src/Database.php",
            "src/Users.php",
            "src/Auth.php",
            "src/OIDCDiscovery.php",
            "src/JwtValidator.php",
            "src/GitHub.php",
            "src/Releases.php",
            "src/Workflow.php",
            "src/View.php",
            "src/Constants.php",
            "src/Csrf.php",
            "src/HttpClient.php"
        ]
    },
    "autoload-dev": {
        "files": [
            "tests/bootstrap.php"
        ]
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "lint": "phpcs",
        "ci": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
